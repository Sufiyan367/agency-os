# Production Reverse Proxy Configuration (Caddy)
# Architecture:
#   Internet (Port 80/443) -> Caddy (Automatic TLS, Compression, Security headers) -> {$UPSTREAM_HOST:127.0.0.1}:8000 (Agency Service)

{$DOMAIN:localhost} {
    # Automatic TLS using Let's Encrypt / ZeroSSL / Internal
    # In production, set DOMAIN=agency.yourdomain.com and TLS_EMAIL in .env
    tls {$TLS_EMAIL:internal}

    # Global compression
    encode zstd gzip

    # Production Security Headers
    header {
        # Strict Transport Security (HSTS)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Prevent MIME type sniffing
        ?X-Content-Type-Options "nosniff"
        # Referrer Policy
        ?Referrer-Policy "strict-origin-when-cross-origin"
        # Permissions Policy
        ?Permissions-Policy "camera=(), microphone=(), geolocation=()"
        # Remove backend server signature
        -Server
    }

    # Route-Specific Framing & Content Security Policy (CSP):
    # The application layer provides fine-grained framing policies ('SAMEORIGIN' and frame-ancestors 'self'
    # for /api/artifacts/*/preview, and 'DENY' with frame-ancestors 'none' for dashboard/API).
    # The '?' prefix ensures Caddy enforces fallback protection without duplicating or overwriting upstream headers.
    header ?X-Frame-Options "DENY"
    header ?Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' ws: wss:; frame-ancestors 'none';"

    # WebSocket Proxy for Live Agent Activity Telemetry
    @websockets {
        header Connection *Upgrade*
        header Upgrade    websocket
    }
    reverse_proxy @websockets {$UPSTREAM_HOST:127.0.0.1}:8000

    # API and Dashboard Proxy
    reverse_proxy {$UPSTREAM_HOST:127.0.0.1}:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Health check upstream monitoring
        health_uri /health
        health_interval 15s
        health_timeout 3s
    }

    # Logging
    log {
        output file /var/log/caddy/agency_access.log {
            roll_size 50mb
            roll_keep 5
        }
        format json
    }
}
