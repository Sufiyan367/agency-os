# =====================================================================
# Autonomous B2B Lead-Gen & Sales Agency - Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 1. APPLICATION CORE
# ---------------------------------------------------------------------
APP_NAME="Autonomous B2B Lead-Gen & Sales Agency"
APP_ENV="development" # development | staging | production
DEBUG=false
HOST="0.0.0.0"
PORT=8000
DOMAIN="agencygrowth.co"
TLS_EMAIL="admin@agencygrowth.co"

# ---------------------------------------------------------------------
# 2. DATABASE PLATFORM (SQLITE LOCAL / POSTGRESQL PRODUCTION)
# ---------------------------------------------------------------------
# Development (Default SQLite):
DATABASE_URL="sqlite+aiosqlite:///agency.db"
SYNC_DATABASE_URL="sqlite:///agency.db"

# Production PostgreSQL (Uncomment and populate for production):
# DATABASE_URL="postgresql+asyncpg://agency_user:StrongPassword123!@db.internal:5432/agency_db"
# SYNC_DATABASE_URL="postgresql+psycopg://agency_user:StrongPassword123!@db.internal:5432/agency_db"

# Enterprise Connection Pool Tuning (PostgreSQL):
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Automated Backups & Disaster Recovery:
BACKUP_DIR="backups"
BACKUP_RETENTION_DAYS=30

# ---------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ---------------------------------------------------------------------
AUTH_ENABLED=true
DASHBOARD_USERNAME="admin"
DASHBOARD_PASSWORD="" # Set initial password or configure via first-launch wizard
VIEWER_USERNAME="viewer"
VIEWER_PASSWORD=""
API_SECRET_KEY="generate-a-64-character-random-hex-key-here"
SESSION_SECRET="generate-another-64-character-random-hex-key-here"
SESSION_MAX_AGE_DAYS=14
ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,https://agencygrowth.co"
RATE_LIMIT_ENABLED=true
WEBHOOK_REPLAY_WINDOW_SECONDS=300
WEBHOOK_SHARED_SECRET="generate-webhook-shared-secret"

# ---------------------------------------------------------------------
# 4. LLM INFERENCE ENGINE
# ---------------------------------------------------------------------
LLM_PROVIDER="auto" # auto | openai | nvidia | openrouter | heuristic
OPENAI_API_KEY=""
NVIDIA_API_KEY=""
OPENROUTER_API_KEY=""
LLM_MODEL="gpt-4o-mini"
NVIDIA_MODEL="meta/llama-3.1-70b-instruct"

# ---------------------------------------------------------------------
# 5. OUTREACH & EMAIL DELIVERY
# ---------------------------------------------------------------------
EMAIL_PROVIDER="dry_run" # dry_run | resend | sendgrid | smtp
EMAIL_DRY_RUN=true
OUTREACH_FROM_EMAIL="prospects@agencygrowth.co"
OUTREACH_FROM_NAME="Elena Vance | Digital Strategy Director"
EMAIL_REPLY_TO="replies@agencygrowth.co"

# Third-party email API credentials (if not dry_run):
RESEND_API_KEY=""
SENDGRID_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# ---------------------------------------------------------------------
# 6. VOICE TELEPHONY (TCPA COMPLIANT)
# ---------------------------------------------------------------------
VOICE_PROVIDER="dry_run" # dry_run | twilio | bland
VOICE_DRY_RUN=true
VOICE_CALLER_ID="+15125550100"
VOICE_RECORDING_ENABLED=true
VOICE_CONSENT_DISCLOSURE="This call may be recorded for quality and diagnostic assurance."
VOICE_MAX_CALL_DURATION_MINUTES=15
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
BLAND_API_KEY=""

# TCPA Safeguards:
CALLING_HOURS_START=8
CALLING_HOURS_END=20
ENFORCE_CALLING_HOURS=true

# ---------------------------------------------------------------------
# 7. PAYMENT GATEWAY (RAZORPAY PRIMARY, STRIPE OPTIONAL)
# ---------------------------------------------------------------------
PAYMENT_PROVIDER="razorpay" # razorpay | stripe | dry_run
PAYMENTS_ENABLED=false
PAYMENT_DRY_RUN=true
RAZORPAY_MODE="test" # test | live
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_CURRENCY="USD"

# Optional Stripe credentials:
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Financial Safeguards ($ USD):
MINIMUM_SERVICE_VALUE_USD=500.0
TARGET_OFFER_MINIMUM_USD=1000.0
COMMERCIAL_FLOOR_USD=500.0
DEFAULT_ADVANCE_PERCENTAGE=40.0

# ---------------------------------------------------------------------
# 8. CRM & INBOX POLLING
# ---------------------------------------------------------------------
IMAP_HOST=""
IMAP_PORT=993
IMAP_USER=""
IMAP_PASSWORD=""
INBOX_POLL_INTERVAL_SECONDS=120

# ---------------------------------------------------------------------
# 9. AUTONOMOUS AGENT ORCHESTRATOR
# ---------------------------------------------------------------------
AUTONOMOUS_AGENT_ENABLED=false # Must be explicitly enabled for automated execution
AUTONOMOUS_OUTREACH=false     # Requires human approval when false
WORKER_ENABLED=true
WORKER_CYCLE_INTERVAL_MINUTES=30
MAX_OUTREACH_PER_DAY=50
MAX_FOLLOWUPS=3
REPLY_STOP_RULE=true
BOUNCE_STOP_RULE=true
OPT_OUT_STOP_RULE=true
