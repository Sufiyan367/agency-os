# Application Configuration
APP_NAME=Autonomous B2B Lead-Gen & Sales Agency
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite default for instant local execution, PostgreSQL supported)
DATABASE_URL=sqlite+aiosqlite:///agency.db

# Autonomous Pipeline Operation Mode
DRY_RUN=true
MAX_OUTREACH_PER_DAY=50
MAX_FOLLOWUPS=3
REPLY_STOP_RULE=true
BOUNCE_STOP_RULE=true
OPT_OUT_STOP_RULE=true

# Model / LLM Settings (Supports NVIDIA, OpenAI, OpenRouter with auto-fallback to rule heuristics)
LLM_PROVIDER=openai
OPENAI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=gpt-4o-mini
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Outreach Sender Configuration (SMTP or Dry Run Mock)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
OUTREACH_FROM_EMAIL=prospects@agencyrevenue.co
OUTREACH_FROM_NAME="Elena Vance | Head of Digital Optimization"

# Lead Scoring Weights
WEIGHT_WEBSITE_WEAKNESS=0.25
WEIGHT_SEO_OPPORTUNITY=0.20
WEIGHT_A11Y_OPPORTUNITY=0.15
WEIGHT_PERFORMANCE_OPPORTUNITY=0.15
WEIGHT_CONVERSION_OPPORTUNITY=0.15
WEIGHT_ABILITY_TO_PAY=0.10
