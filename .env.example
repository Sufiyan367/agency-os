# ==============================================================================
# Autonomous B2B Lead-Gen & Sales Agency — Environment Configuration Template
# Copy this file to .env and configure for local or production execution.
# NEVER commit your real secrets to version control.
# ==============================================================================

# Application & Networking
APP_NAME=Autonomous B2B Lead-Gen & Sales Agency
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Cloud Domain & Automatic HTTPS (Let's Encrypt via Caddy)
# Set your real domain (e.g. agency.yourdomain.com) for production SSL certificates.
DOMAIN=localhost
TLS_EMAIL=admin@example.com

# Operator Dashboard Authentication Gate
AUTH_ENABLED=true
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_this_to_a_strong_password
API_SECRET_KEY=change_this_to_a_random_32_byte_hex_key
SESSION_SECRET=change_this_to_another_random_32_byte_hex_key

# Persistent Database Storage & Automated Backups
DATABASE_URL=sqlite+aiosqlite:///agency.db
SYNC_DATABASE_URL=sqlite:///agency.db
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# Unattended 24/7 Background Worker Cadence
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=60
WORKER_CYCLE_INTERVAL_MINUTES=30

# Compliance & Safeguards (Dry Run Safeguard ON by Default)
DRY_RUN=true
MAX_OUTREACH_PER_DAY=50
MAX_FOLLOWUPS=3
REPLY_STOP_RULE=true
BOUNCE_STOP_RULE=true
OPT_OUT_STOP_RULE=true

# Real Email Delivery Provider
# Options: 'dry_run' (default, safe simulation), 'resend', 'sendgrid', 'smtp'
EMAIL_PROVIDER=dry_run
EMAIL_DRY_RUN=true
EMAIL_FROM=prospects@youragencydomain.com
EMAIL_FROM_NAME="Elena Vance | Head of Digital Optimization"

# Resend API Key (https://resend.com)
RESEND_API_KEY=

# SendGrid API Key (https://sendgrid.com)
SENDGRID_API_KEY=

# Optional SMTP Fallback
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Primary Payment Gateway: Razorpay
# Options: 'razorpay' (default), 'stripe', 'dry_run'
PAYMENT_PROVIDER=razorpay
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=USD

# Optional Secondary Payment Gateway: Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI & Market Intelligence / LLM API Keys (Optional: heuristic engines run autonomously without LLMs)
OPENAI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
