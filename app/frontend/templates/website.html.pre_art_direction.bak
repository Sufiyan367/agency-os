          <div id="inlineContactAlert" role="alert" class="hidden mb-4 p-3.5 rounded-xl text-xs font-medium"></div>

          <form id="inlineContactForm" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
