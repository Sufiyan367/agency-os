<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Agency OS — AI Systems &amp; Automation</title>
  <meta
    name="description"
    content="Agency OS builds custom AI systems, autonomous agents, and production software workflows that eliminate repetitive business operations."
  />
  <meta property="og:title" content="Agency OS — AI Systems &amp; Automation" />
  <meta property="og:description" content="We build AI-powered automation, custom software, agents, and business workflows that remove repetitive manual work." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://automatedagencyos.tech" />

  <!-- Google Fonts: Inter Display & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
            mono: ['JetBrains Mono', 'ui-monospace', 'monospace']
          },
          colors: {
            brand: {
              black: '#070707',
              dark: '#0a0a0c',
              card: '#111114',
              border: 'rgba(255, 255, 255, 0.08)',
              emerald: '#10b981',
              cyan: '#06b6d4',
              amber: '#f59e0b',
              accent: '#38bdf8'
            }
          }
        }
      }
    };
  </script>

  <style>
    /* Base & Smooth Scrolling */
    html {
      scroll-behavior: smooth;
      background-color: #070707;
      color: #f3f4f6;
      font-feature-settings: "cv02", "cv03", "cv04", "cv11";
    }
    body {
      background-color: #070707;
      min-height: 100%;
      overflow-x: hidden;
      overflow-y: auto;
    }

    /* Scroll Reveal Transition */
    .scroll-reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }
    .scroll-reveal.in-view {
      opacity: 1;
      transform: translateY(0);
    }

    /* Glass Panels with Mainframe Edge Glow */
    .glass-card {
      background: rgba(15, 15, 18, 0.72);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    }
    .glass-card:hover {
      border-color: rgba(255, 255, 255, 0.18);
      box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.7);
    }

    .glass-pill {
      background: rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      transition: all 0.25s ease;
    }
    .glass-pill:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.25);
    }

    /* Precision CTA Button */
    .cta-dark-gradient {
      background: linear-gradient(135deg, #18181b 0%, #09090b 100%);
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.6), inset 0 1px 1px 0 rgba(255, 255, 255, 0.2);
      transition: all 0.25s ease;
    }
    .cta-dark-gradient:hover {
      border-color: rgba(255, 255, 255, 0.35);
      box-shadow: 0 8px 30px -4px rgba(0, 0, 0, 0.8), inset 0 1px 2px 0 rgba(255, 255, 255, 0.35);
      transform: translateY(-1px);
    }
    .cta-dark-gradient:active {
      transform: translateY(0);
    }

    /* Infinite Marquee */
    @keyframes marquee {
      0% { transform: translateX(0%); }
      100% { transform: translateX(-50%); }
    }
    .marquee-track {
      display: flex;
      width: 200%;
      animation: marquee 35s linear infinite;
    }
    .marquee-track:hover {
      animation-play-state: paused;
    }

    /* Workflow Flow Line Animation */
    @keyframes pulseFlow {
      0%, 100% { opacity: 0.3; transform: scaleY(0.9); }
      50% { opacity: 1; transform: scaleY(1.05); }
    }
    .pulse-flow-arrow {
      animation: pulseFlow 2s ease-in-out infinite;
    }

    /* Browser Window Mockup Frame */
    .browser-frame {
      background: #09090b;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.05);
    }
    .browser-chrome {
      background: #121215;
      padding: 12px 18px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* Modal Backdrop */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }
    .modal-backdrop.open {
      opacity: 1;
      pointer-events: auto;
    }
    .modal-box {
      background: #0c0c0e;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 20px;
      box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.9);
      width: 100%;
      max-width: 540px;
      padding: 32px;
      margin: 16px;
      position: relative;
      transform: translateY(16px) scale(0.98);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .modal-backdrop.open .modal-box {
      transform: translateY(0) scale(1);
    }

    /* Subtle Border Grid Section Dividers */
    .section-border {
      border-top: 1px solid rgba(255, 255, 255, 0.07);
    }
  </style>
</head>

<body class="font-sans antialiased text-white selection:bg-emerald-500/30 selection:text-emerald-200">

  <!-- ====================================================================
       00 NAVIGATION (EDITORIAL, LIGHT, AND MINIMALIST)
       ==================================================================== -->
  <header class="sticky top-0 z-50 w-full px-5 py-3.5 sm:px-8 lg:px-12 flex items-center justify-between bg-[#070707]/85 backdrop-blur-xl border-b border-white/10 transition-all">
    <!-- Brand Wordmark -->
    <a href="#home" class="flex items-center gap-3 group focus:outline-none" aria-label="Agency OS Home">
      <div class="w-8 h-8 rounded-lg bg-white/10 border border-white/15 flex items-center justify-center font-mono font-bold text-xs tracking-tight text-white group-hover:border-emerald-400/50 transition">
        OS
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-sm tracking-tight text-white group-hover:text-white/90">AGENCY OS</span>
        <span class="text-[9px] font-mono tracking-widest text-white/40 uppercase">Systems &bull; Studio</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-7 text-xs font-medium text-white/70 tracking-wide" aria-label="Main Navigation">
      <a href="#solutions" class="hover:text-white transition py-1">Solutions</a>
      <a href="#problems" class="hover:text-white transition py-1">Problems</a>
      <a href="#how-it-works" class="hover:text-white transition py-1">How It Works</a>
      <a href="#demos" class="hover:text-white transition py-1">Demos</a>
      <a href="#automation" class="hover:text-white transition py-1">Automation</a>
      <a href="#contact" class="hover:text-white transition py-1">Contact</a>
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3">
      <a href="/login" class="text-xs font-medium text-white/60 hover:text-white transition px-2 py-1">Operator Sign In</a>
      <button
        type="button"
        class="hidden sm:inline-flex cta-dark-gradient rounded-full px-4 py-2 text-xs font-semibold text-white items-center gap-1.5 shadow-md"
        data-action="open-consultation-modal"
      >
        <span>Get Your Automation Built</span>
        <span class="text-emerald-400">&rarr;</span>
      </button>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        class="md:hidden flex items-center justify-center w-9 h-9 rounded-lg border border-white/10 bg-white/5 text-white/80 hover:text-white focus:outline-none"
        id="burgerBtn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg id="burgerMenuIcon" class="w-5 h-5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="burgerCloseIcon" class="w-5 h-5 hidden transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </header>

  <!-- Mobile Drawer -->
  <div id="mobileBackdrop" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden" aria-hidden="true"></div>
  <div
    id="mobileDrawer"
    class="fixed top-[57px] right-0 bottom-0 w-72 bg-[#0c0c0e] border-l border-white/10 z-40 translate-x-full transition-transform duration-300 ease-out md:hidden flex flex-col justify-between p-6 overflow-y-auto"
    aria-hidden="true"
  >
    <div class="space-y-6">
      <div class="text-[10px] font-mono font-semibold tracking-widest text-white/40 uppercase">Navigation</div>
      <nav class="flex flex-col space-y-4 text-sm font-medium text-white/80">
        <a href="#home" class="mobile-link hover:text-white transition py-1">Home</a>
        <a href="#solutions" class="mobile-link hover:text-white transition py-1">Solutions</a>
        <a href="#problems" class="mobile-link hover:text-white transition py-1">Problems</a>
        <a href="#how-it-works" class="mobile-link hover:text-white transition py-1">How It Works</a>
        <a href="#demos" class="mobile-link hover:text-white transition py-1">Working Demos</a>
        <a href="#automation" class="mobile-link hover:text-white transition py-1">Workflow Automation</a>
        <a href="#contact" class="mobile-link hover:text-white transition py-1">Contact</a>
        <a href="/login" class="mobile-link rounded-xl px-4 py-2 text-sm font-medium text-blue-400 hover:bg-white/10 transition">Operator Sign In &rarr;</a>
      </nav>
    </div>
    <div class="pt-6 border-t border-white/10">
      <button
        type="button"
        class="cta-dark-gradient w-full rounded-full py-3 text-center text-xs font-semibold text-white shadow-xl"
        data-action="open-consultation-modal"
      >
        Get Your Automation Built
      </button>
    </div>
  </div>

  <!-- ====================================================================
       01 HERO SECTION (CINEMATIC BACKGROUND + EDITORIAL WORKFLOW VISUAL)
       ==================================================================== -->
  <section id="home" class="relative min-h-[calc(100vh-65px)] w-full overflow-hidden flex flex-col justify-center py-16 sm:py-20">

    <!-- Full-Bleed Background Video strictly constrained inside hero -->
    <video
      class="absolute inset-0 h-full w-full object-cover pointer-events-none opacity-40 mix-blend-screen"
      autoplay
      loop
      muted
      playsinline
      aria-hidden="true"
    >
      <source
        src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260809_012548_ef22562c-c0ae-4816-ad9d-f8922af4e6a7.mp4"
        type="video/mp4"
      />
    </video>

    <!-- Subtle Cinematic Scrim to Guarantee Text Readability -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#070707] via-[#070707]/75 to-[#070707]/60 pointer-events-none" aria-hidden="true"></div>

    <!-- UI Layer -->
    <div class="relative z-10 w-full max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 my-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">

        <!-- Left: Value Proposition & CTAs -->
        <div class="lg:col-span-7 flex flex-col">
          <!-- Operating-System-Style Status Detail -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 backdrop-blur-md text-[11px] font-mono uppercase tracking-wider text-white/80 mb-5 sm:mb-6 self-start">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" aria-hidden="true"></span>
            <span>SYSTEM // ONLINE</span>
            <span class="text-white/30">&bull;</span>
            <span class="text-white/60">AUTONOMOUS BUSINESS WORKFLOWS</span>
          </div>

          <!-- Primary Statement -->
          <h1 class="text-4xl sm:text-6xl lg:text-[4.25rem] font-semibold text-white leading-[1.04] tracking-tight">
            AI systems that automate your business.
          </h1>

          <!-- Supporting Message -->
          <p class="mt-5 text-base sm:text-lg text-white/75 max-w-xl leading-relaxed">
            We build AI-powered automation, custom software, and business workflows that reduce repetitive manual work.
          </p>

          <!-- Primary & Secondary CTAs -->
          <div class="mt-8 flex flex-row items-center gap-4 flex-wrap">
            <button
              type="button"
              class="cta-dark-gradient rounded-full px-6 py-3.5 text-sm font-semibold text-white shadow-xl flex items-center justify-center gap-2 text-center"
              data-action="open-consultation-modal"
            >
              <span>Get Your Automation Built</span>
              <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>

            <a
              href="#demos"
              class="glass-pill rounded-full px-5 py-3.5 text-sm font-medium text-white/80 hover:text-white flex items-center justify-center gap-2 text-center"
            >
              <span>See a Working Demo</span>
              <svg class="w-4 h-4 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polygon points="10 8 16 12 10 16 10 8"></polygon>
              </svg>
            </a>
          </div>

          <!-- Subtle OS Metadata Strip -->
          <div class="mt-8 pt-5 border-t border-white/10 flex items-center gap-6 text-[11px] font-mono text-white/40">
            <span>DISPATCH: SUB-60S</span>
            <span>&bull;</span>
            <span>INTEGRATIONS: ANY CRM</span>
            <span>&bull;</span>
            <span>ZERO DROPPED LEADS</span>
          </div>
        </div>

        <!-- Right: Animated Workflow Visual System (Visually Proves We Build Systems) -->
        <div class="lg:col-span-5 w-full">
          <div class="glass-card rounded-2xl p-6 sm:p-7 border-white/15 bg-black/60 shadow-2xl relative overflow-hidden">
            
            <!-- Terminal Header -->
            <div class="flex items-center justify-between pb-4 mb-5 border-b border-white/10 text-xs font-mono text-white/50">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                <span class="text-white/80 font-bold uppercase tracking-wider">LIVE WORKFLOW SYSTEM</span>
              </div>
              <span class="text-emerald-400 text-[10px] font-semibold uppercase px-2 py-0.5 rounded bg-emerald-950/40 border border-emerald-500/20">AUTONOMOUS</span>
            </div>

            <!-- Vertical Connected Flow Pipeline -->
            <div class="space-y-2.5 font-mono text-xs relative">

              <!-- Node 1: Lead -->
              <div class="flex items-center justify-between p-3 rounded-xl bg-white/[0.03] border border-white/10 hover:border-white/20 transition">
                <div class="flex items-center gap-3">
                  <div class="w-6 h-6 rounded-md bg-blue-500/20 text-blue-400 flex items-center justify-center text-[10px] font-bold">01</div>
                  <div>
                    <div class="text-white font-semibold">INBOUND LEAD</div>
                    <div class="text-[10px] text-white/40">Web submission or missed call</div>
                  </div>
                </div>
                <span class="text-[10px] text-blue-400 font-medium">&lt; 100ms</span>
              </div>

              <!-- Connector Line -->
              <div class="flex justify-center -my-1 text-white/30 text-xs font-mono select-none">&darr;</div>

              <!-- Node 2: AI Qualification -->
              <div class="flex items-center justify-between p-3 rounded-xl bg-white/[0.03] border border-white/10 hover:border-white/20 transition">
                <div class="flex items-center gap-3">
                  <div class="w-6 h-6 rounded-md bg-purple-500/20 text-purple-400 flex items-center justify-center text-[10px] font-bold">02</div>
                  <div>
                    <div class="text-white font-semibold">AI QUALIFICATION</div>
                    <div class="text-[10px] text-white/40">Evaluates budget &amp; scope intent</div>
                  </div>
                </div>
                <span class="text-[10px] text-purple-400 font-medium">Scored</span>
              </div>

              <!-- Connector Line -->
              <div class="flex justify-center -my-1 text-white/30 text-xs font-mono select-none">&darr;</div>

              <!-- Node 3: CRM -->
              <div class="flex items-center justify-between p-3 rounded-xl bg-white/[0.03] border border-white/10 hover:border-white/20 transition">
                <div class="flex items-center gap-3">
                  <div class="w-6 h-6 rounded-md bg-amber-500/20 text-amber-400 flex items-center justify-center text-[10px] font-bold">03</div>
                  <div>
                    <div class="text-white font-semibold">CRM SYNC</div>
                    <div class="text-[10px] text-white/40">HubSpot / Salesforce / Custom DB</div>
                  </div>
                </div>
                <span class="text-[10px] text-amber-400 font-medium">Bi-Directional</span>
              </div>

              <!-- Connector Line -->
              <div class="flex justify-center -my-1 text-white/30 text-xs font-mono select-none">&darr;</div>

              <!-- Node 4: Follow-Up -->
              <div class="flex items-center justify-between p-3 rounded-xl bg-white/[0.03] border border-white/10 hover:border-white/20 transition">
                <div class="flex items-center gap-3">
                  <div class="w-6 h-6 rounded-md bg-cyan-500/20 text-cyan-400 flex items-center justify-center text-[10px] font-bold">04</div>
                  <div>
                    <div class="text-white font-semibold">SMART FOLLOW-UP</div>
                    <div class="text-[10px] text-white/40">Sub-60s SMS &bull; Halts on reply</div>
                  </div>
                </div>
                <span class="text-[10px] text-cyan-400 font-medium">Active Drip</span>
              </div>

              <!-- Connector Line -->
              <div class="flex justify-center -my-1 text-white/30 text-xs font-mono select-none">&darr;</div>

              <!-- Node 5: Booking -->
              <div class="flex items-center justify-between p-3 rounded-xl bg-white/[0.03] border border-white/10 hover:border-white/20 transition">
                <div class="flex items-center gap-3">
                  <div class="w-6 h-6 rounded-md bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-[10px] font-bold">05</div>
                  <div>
                    <div class="text-white font-semibold">CALENDAR BOOKING</div>
                    <div class="text-[10px] text-white/40">Direct slot reservation</div>
                  </div>
                </div>
                <span class="text-[10px] text-emerald-400 font-medium">Confirmed</span>
              </div>

              <!-- Connector Line -->
              <div class="flex justify-center -my-1 text-white/30 text-xs font-mono select-none">&darr;</div>

              <!-- Node 6: Team Alert -->
              <div class="flex items-center justify-between p-3 rounded-xl bg-emerald-950/20 border border-emerald-500/30">
                <div class="flex items-center gap-3">
                  <div class="w-6 h-6 rounded-md bg-emerald-500/30 text-emerald-300 flex items-center justify-center text-[10px] font-bold">06</div>
                  <div>
                    <div class="text-emerald-300 font-semibold">TEAM ALERT</div>
                    <div class="text-[10px] text-emerald-400/80">Slack / Mobile / Dispatch Notification</div>
                  </div>
                </div>
                <span class="text-[10px] text-emerald-400 font-bold">DISPATCHED</span>
              </div>

            </div>

            <!-- Footer Statement -->
            <div class="mt-5 pt-3 border-t border-white/10 flex items-center justify-between text-[10px] text-white/40 font-mono">
              <span>Zero Human Bottlenecks</span>
              <span class="text-emerald-400 font-medium">Running 24/7/365</span>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ====================================================================
       02 VISUAL SHOWCASE / MARQUEE (EDITORIAL FULL-WIDTH TRANSITION)
       ==================================================================== -->
  <section class="border-y border-white/10 bg-[#0a0a0c] py-8 sm:py-10 overflow-hidden" aria-label="Capabilities Marquee">
    <div class="marquee-track flex items-center gap-10 sm:gap-14 font-extrabold tracking-tighter uppercase whitespace-nowrap text-2xl sm:text-4xl lg:text-5xl text-white/30 hover:text-white/60 transition-colors">
      <span class="hover:text-white transition">AI Automation</span>
      <span class="text-emerald-400/40 text-lg sm:text-xl">&bull;</span>
      <span class="hover:text-white transition">Custom Software</span>
      <span class="text-emerald-400/40 text-lg sm:text-xl">&bull;</span>
      <span class="hover:text-white transition">AI Agents</span>
      <span class="text-emerald-400/40 text-lg sm:text-xl">&bull;</span>
      <span class="hover:text-white transition">Workflow Automation</span>
      <span class="text-emerald-400/40 text-lg sm:text-xl">&bull;</span>
      <span class="hover:text-white transition">Business Dashboards</span>
      <span class="text-emerald-400/40 text-lg sm:text-xl">&bull;</span>
      <span class="hover:text-white transition">Customer Systems</span>
      <span class="text-emerald-400/40 text-lg sm:text-xl">&bull;</span>
      <span class="hover:text-white transition">Business Process Automation</span>
      <span class="text-emerald-400/40 text-lg sm:text-xl">&bull;</span>
      <span class="hover:text-white transition">Ongoing Management</span>
      <span class="text-emerald-400/40 text-lg sm:text-xl">&bull;</span>
    </div>
  </section>

  <!-- ====================================================================
       03 WHAT WE BUILD (#solutions) — EDITORIAL ALTERNATING SERVICE SECTIONS
       ==================================================================== -->
  <section id="solutions" class="section-border py-24 sm:py-32 px-5 sm:px-8 lg:px-12 max-w-7xl mx-auto w-full scroll-reveal">
    
    <!-- Section Header: Large Editorial Statement -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-16 sm:mb-20">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-mono font-medium text-emerald-400 uppercase tracking-widest mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
