        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <input
            type="text"
            id="consultationName"
            name="name"
            class="w-full bg-white/5 border border-white/15 rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-white/40 focus:outline-none focus:border-white/40"
            placeholder="Full Name *"
            required
          />
          <input
            type="text"
            id="consultationCompany"
            name="company"
            class="w-full bg-white/5 border border-white/15 rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-white/40 focus:outline-none focus:border-white/40"
            placeholder="Company Name *"
            required
          />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <input
            type="email"
            id="consultationEmail"
            name="email"
            class="w-full bg-white/5 border border-white/15 rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-white/40 focus:outline-none focus:border-white/40"
            placeholder="Business Email *"
            required
          />
          <input
            type="text"
            id="consultationWebsite"
            name="website"
            class="w-full bg-white/5 border border-white/15 rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-white/40 focus:outline-none focus:border-white/40"
            placeholder="Website Domain *"
            required
          />
        </div>
        <textarea
          id="consultationAutomated"
          name="what_they_want_automated"
          rows="2"
          class="w-full bg-white/5 border border-white/15 rounded-lg px-3.5 py-2 text-sm text-white placeholder-white/40 focus:outline-none focus:border-white/40"
          placeholder="What processes do you want automated? *"
          required
        ></textarea>
        <textarea
          id="consultationProblem"
          name="problem"
          rows="2"
          class="w-full bg-white/5 border border-white/15 rounded-lg px-3.5 py-2 text-sm text-white placeholder-white/40 focus:outline-none focus:border-white/40"
          placeholder="What is your biggest manual bottleneck? *"
          required
        ></textarea>

        <button
          type="submit"
          id="consultationSubmitBtn"
          class="cta-dark-gradient w-full rounded-lg py-3 text-sm font-semibold text-white shadow-lg tracking-wide hover:opacity-95 transition"
        >
          Submit Specification &amp; Assessment Request
        </button>
        <p class="text-[11px] text-white/40 text-center font-mono">We respect your privacy. Zero spam. Direct engineer response within 24 business hours.</p>
      </form>
    </div>
  </div>

  <!-- Interactive Logic: Scroll Reveal, Mobile Drawer, Lead Capture, and Tab Switcher -->
  <script>
    (function () {
      'use strict';

      // Elements
      const burgerBtn = document.getElementById('burgerBtn');
      const burgerMenuIcon = document.getElementById('burgerMenuIcon');
      const burgerCloseIcon = document.getElementById('burgerCloseIcon');
      const mobileBackdrop = document.getElementById('mobileBackdrop');
      const mobileDrawer = document.getElementById('mobileDrawer');
      const consultationModal = document.getElementById('consultationModal');
      const closeConsultationModal = document.getElementById('closeConsultationModal');
      const consultationForm = document.getElementById('consultationForm');
      const consultationAlert = document.getElementById('consultationAlert');
      const consultationSubmitBtn = document.getElementById('consultationSubmitBtn');

      let isDrawerOpen = false;

      // Scroll Reveal
      function initScrollAnimations() {
        if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                obs.unobserve(entry.target);
              }
            });
          }, { threshold: 0.01, rootMargin: '0px 0px 100px 0px' });

          document.querySelectorAll('.scroll-reveal').forEach(el => {
            observer.observe(el);
          });
        } else {
          document.querySelectorAll('.scroll-reveal').forEach(el => {
            el.classList.add('in-view');
          });
        }
      }
      initScrollAnimations();

      // Mobile Drawer Toggle
      function openDrawer() {
        isDrawerOpen = true;
        burgerBtn.setAttribute('aria-expanded', 'true');
        burgerMenuIcon.classList.add('hidden');
        burgerCloseIcon.classList.remove('hidden');
        mobileBackdrop.classList.remove('opacity-0', 'pointer-events-none');
        mobileBackdrop.classList.add('opacity-100', 'pointer-events-auto');
        mobileDrawer.classList.remove('translate-x-full');
        mobileDrawer.classList.add('translate-x-0');
        mobileDrawer.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function closeDrawer() {
        isDrawerOpen = false;
        burgerBtn.setAttribute('aria-expanded', 'false');
        burgerMenuIcon.classList.remove('hidden');
        burgerCloseIcon.classList.add('hidden');
        mobileBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
        mobileBackdrop.classList.add('opacity-0', 'pointer-events-none');
        mobileDrawer.classList.remove('translate-x-0');
        mobileDrawer.classList.add('translate-x-full');
        mobileDrawer.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      if (burgerBtn) {
        burgerBtn.addEventListener('click', function () {
          if (isDrawerOpen) closeDrawer();
          else openDrawer();
        });
      }

      if (mobileBackdrop) {
        mobileBackdrop.addEventListener('click', closeDrawer);
      }

      document.querySelectorAll('.mobile-link').forEach(link => {
        link.addEventListener('click', closeDrawer);
      });

      window.addEventListener('resize', function () {
        if (window.innerWidth >= 768 && isDrawerOpen) {
          closeDrawer();
        }
      });

      // Modal Handling
      function openModal() {
        closeDrawer();
        consultationModal.classList.add('open');
        consultationModal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        consultationModal.classList.remove('open');
        consultationModal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      document.querySelectorAll('[data-action="open-consultation-modal"]').forEach(btn => {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          openModal();
        });
      });

      if (closeConsultationModal) {
        closeConsultationModal.addEventListener('click', closeModal);
      }

      if (consultationModal) {
        consultationModal.addEventListener('click', function (e) {
          if (e.target === consultationModal) closeModal();
        });
      }

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          if (isDrawerOpen) closeDrawer();
          if (consultationModal && consultationModal.classList.contains('open')) closeModal();
        }
      });

      // Workflow Tab Switcher
      const wfData = {
        'missed-call': {
          title: 'Missed-Call Recovery & Immediate Lead Capture',
          desc: 'Sub-30 second automated SMS text-back to missed customer calls with caller identification, business hours detection, and CRM logging with Operational Alerts & Notifications.',
          nodes: ['MISSED CALL', 'AI RESPONSE', 'LEAD CAPTURE', 'CRM & DB', 'FOLLOW-UP', 'BOOKING']
        },
        'lead-followup': {
          title: 'Multi-Stage Inbound Lead Follow-Up Sequence',
          desc: 'Automated 1h, 24h, and 72h precision follow-up sequences that systematically nurture warm quotes and auto-halt the moment a customer replies.',
          nodes: ['WEB LEAD', 'ENRICHMENT', 'CRM LOG', 'SMS & EMAIL', 'REPLY DETECT', 'QUALIFIED']
        },
        'appointment-reminder': {
          title: '24/7 Appointment Confirmation & Rescheduling',
          desc: 'Automated 24-hour and 2-hour pre-visit confirmations with one-click rescheduling links that prevent revenue loss from customer no-shows.',
          nodes: ['CALENDAR', '24H SMS', '2H ALERT', 'RESCHEDULE', 'CAL SYNC', 'CONFIRMED']
        },
        'estimate-followup': {
          title: 'Post-Estimate Follow-Up & Deposit Collection',
          desc: 'Gentle structured follow-ups after an estimate is sent, addressing common questions, offering scheduling slots, and collecting deposit agreements.',
          nodes: ['ESTIMATE', 'CHECK-IN', 'FAQ BOT', 'PROPOSAL', 'DEPOSIT', 'WON DEAL']
        },
        'review-request': {
          title: 'Automated Post-Service Review Collection',
          desc: 'Automated customer satisfaction surveys sent following completed appointments, guiding happy clients directly to public review platforms.',
          nodes: ['JOB DONE', 'NPS SURVEY', 'RATING > 4', 'DIRECT LINK', 'CRM LOG', 'REPUTATION']
        }
      };

      const wfTabs = document.querySelectorAll('.workflow-tab');
      const wfTitle = document.getElementById('wfDisplayTitle');
      const wfDesc = document.getElementById('wfDisplayDesc');
      const wfGrid = document.getElementById('wfNodesGrid');

      wfTabs.forEach(tab => {
        tab.addEventListener('click', function () {
          const key = this.getAttribute('data-wf');
          const data = wfData[key];
          if (!data) return;

          wfTabs.forEach(t => {
            t.classList.remove('active', 'bg-white/10', 'text-white', 'border-white/20');
            t.classList.add('bg-white/5', 'text-white/60', 'border-transparent');
          });
          this.classList.add('active', 'bg-white/10', 'text-white', 'border-white/20');
          this.classList.remove('bg-white/5', 'text-white/60', 'border-transparent');

          if (wfTitle) wfTitle.textContent = data.title;
          if (wfDesc) wfDesc.textContent = data.desc;

          if (wfGrid && data.nodes) {
            wfGrid.innerHTML = `
              <div class="p-4 rounded-xl bg-white/5 border border-white/10 text-center">
                <div class="text-[10px] text-blue-400 font-bold mb-1">01 TRIGGER</div>
                <div class="text-white font-semibold">${data.nodes[0]}</div>
              </div>
              <div class="hidden md:flex justify-center text-white/30">&rarr;</div>
              <div class="p-4 rounded-xl bg-white/5 border border-white/10 text-center">
                <div class="text-[10px] text-purple-400 font-bold mb-1">02 LOGIC</div>
                <div class="text-white font-semibold">${data.nodes[1]}</div>
              </div>
              <div class="hidden md:flex justify-center text-white/30">&rarr;</div>
              <div class="p-4 rounded-xl bg-white/5 border border-white/10 text-center">
                <div class="text-[10px] text-amber-400 font-bold mb-1">03 INTAKE</div>
                <div class="text-white font-semibold">${data.nodes[2]}</div>
              </div>
              <div class="hidden md:flex justify-center text-white/30">&rarr;</div>
              <div class="p-4 rounded-xl bg-white/5 border border-white/10 text-center">
                <div class="text-[10px] text-cyan-400 font-bold mb-1">04 SYNC</div>
                <div class="text-white font-semibold">${data.nodes[3]}</div>
              </div>
              <div class="hidden md:flex justify-center text-white/30">&rarr;</div>
              <div class="p-4 rounded-xl bg-white/5 border border-white/10 text-center">
                <div class="text-[10px] text-emerald-400 font-bold mb-1">05 CADENCE</div>
                <div class="text-white font-semibold">${data.nodes[4]}</div>
              </div>
              <div class="hidden md:flex justify-center text-white/30">&rarr;</div>
              <div class="p-4 rounded-xl bg-emerald-950/40 border border-emerald-500/30 text-center text-emerald-300">
                <div class="text-[10px] font-bold mb-1">06 OUTCOME</div>
                <div class="font-bold">${data.nodes[5]}</div>
              </div>
            `;
          }
        });
      });

      // Lead Submission via Consultation Modal
      if (consultationForm) {
        consultationForm.addEventListener('submit', async function (e) {
          e.preventDefault();

          consultationAlert.className = 'hidden mb-4 p-3 rounded-lg text-xs font-medium';
          consultationAlert.textContent = '';
          consultationSubmitBtn.disabled = true;
          const origText = consultationSubmitBtn.textContent;
          consultationSubmitBtn.textContent = 'Submitting Request...';

          const payload = {
            name: document.getElementById('consultationName').value.trim(),
            company: document.getElementById('consultationCompany').value.trim(),
            email: document.getElementById('consultationEmail').value.trim(),
            website: document.getElementById('consultationWebsite').value.trim(),
            service_interest: 'AI Automation & Custom Software',
            problem: document.getElementById('consultationProblem').value.trim(),
            what_they_want_automated: document.getElementById('consultationAutomated').value.trim(),
            message: `Automate: ${document.getElementById('consultationAutomated').value.trim()} | Bottleneck: ${document.getElementById('consultationProblem').value.trim()}`
          };

          try {
            let res = await fetch('/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            if (res.status === 404) {
              res = await fetch('/api/v1/onboarding/consultation', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  name: payload.name,
                  email: payload.email,
                  company: payload.company,
                  service_interest: payload.service_interest,
                  notes: payload.message,
                  current_process: payload.message
                })
              });
            }

            if (res.ok) {
              consultationAlert.className = 'mb-4 p-3 rounded-lg text-xs font-medium bg-emerald-950/80 border border-emerald-600 text-emerald-300';
              consultationAlert.textContent = 'Thank you — your assessment request has been received. Our engineering team will review your business process and respond within 24 business hours.';
              consultationForm.reset();
              setTimeout(() => { closeModal(); }, 3500);
            } else {
              let errorMsg = 'Unable to process request. Please verify all fields and retry.';
              try {
                const data = await res.json();
                if (data && data.detail) errorMsg = typeof data.detail === 'string' ? data.detail : JSON.stringify(data.detail);
              } catch (_) {}
              consultationAlert.className = 'mb-4 p-3 rounded-lg text-xs font-medium bg-red-950/80 border border-red-600 text-red-300';
              consultationAlert.textContent = errorMsg;
            }
          } catch (err) {
            consultationAlert.className = 'mb-4 p-3 rounded-lg text-xs font-medium bg-red-950/80 border border-red-600 text-red-300';
            consultationAlert.textContent = 'Network error connecting to server. Please try again.';
          } finally {
            consultationSubmitBtn.disabled = false;
            consultationSubmitBtn.textContent = origText;
          }
        });
      }

      // Inline Contact Form Submission
      const inlineForm = document.getElementById('inlineContactForm');
      const inlineAlert = document.getElementById('inlineContactAlert');
      const inlineSubmitBtn = document.getElementById('inlineSubmitBtn');

      if (inlineForm) {
        inlineForm.addEventListener('submit', async function (e) {
          e.preventDefault();

          inlineAlert.className = 'hidden mb-4 p-3 rounded-lg text-xs font-medium';
          inlineAlert.textContent = '';
          inlineSubmitBtn.disabled = true;
          const origText = inlineSubmitBtn.textContent;
          inlineSubmitBtn.textContent = 'Submitting Request...';

          const payload = {
            name: document.getElementById('inlineName').value.trim(),
            company: document.getElementById('inlineCompany').value.trim(),
            email: document.getElementById('inlineEmail').value.trim(),
            website: document.getElementById('inlineWebsite').value.trim(),
            service_interest: 'AI Automation & Custom Software',
            problem: document.getElementById('inlineProblem').value.trim(),
            what_they_want_automated: document.getElementById('inlineAutomated').value.trim(),
            message: `Automate: ${document.getElementById('inlineAutomated').value.trim()} | Bottleneck: ${document.getElementById('inlineProblem').value.trim()}`
          };

          try {
            let res = await fetch('/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            if (res.status === 404) {
              res = await fetch('/api/v1/onboarding/consultation', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  name: payload.name,
                  email: payload.email,
                  company: payload.company,
                  service_interest: payload.service_interest,
                  notes: payload.message,
                  current_process: payload.message
                })
              });
            }

            if (res.ok) {
              inlineAlert.className = 'mb-4 p-3.5 rounded-xl text-xs font-medium bg-emerald-950/80 border border-emerald-600 text-emerald-300';
              inlineAlert.textContent = 'Thank you — your assessment request has been received. Our engineering team will review your business process and respond within 24 business hours.';
              inlineForm.reset();
            } else {
              let errorMsg = 'Unable to process request. Please verify all fields and retry.';
              try {
                const data = await res.json();
                if (data && data.detail) errorMsg = typeof data.detail === 'string' ? data.detail : JSON.stringify(data.detail);
              } catch (_) {}
              inlineAlert.className = 'mb-4 p-3.5 rounded-xl text-xs font-medium bg-red-950/80 border border-red-600 text-red-300';
              inlineAlert.textContent = errorMsg;
            }
          } catch (err) {
            inlineAlert.className = 'mb-4 p-3.5 rounded-xl text-xs font-medium bg-red-950/80 border border-red-600 text-red-300';
            inlineAlert.textContent = 'Network error connecting to server. Please try again.';
          } finally {
            inlineSubmitBtn.disabled = false;
            inlineSubmitBtn.textContent = origText;
          }
        });
      }

    })();
  </script>
</body>
</html>
