<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <base href="/">
  <title>Agency OS — AI Systems &amp; Automation</title>

  <!-- SEO & Canonical Metadata -->
  <meta name="description" content="We build AI-powered automation, custom software, and business workflows that reduce repetitive manual work.">
  <meta name="keywords" content="AI Automation, Custom Software, Workflow Automation, n8n Automation, AI Agents, Business Process Automation">
  <meta name="author" content="Agency OS">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#070707">
  <link rel="canonical" href="https://automatedagencyos.tech/">

  <!-- OpenGraph Metadata -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="Agency OS — AI Systems &amp; Automation">
  <meta property="og:description" content="We build AI-powered automation, custom software, and business workflows that reduce repetitive manual work.">
  <meta property="og:url" content="https://automatedagencyos.tech/">
  <meta property="og:site_name" content="Agency OS">
  <meta property="og:image" content="https://automatedagencyos.tech/assets/logo.webp">

  <!-- Twitter Metadata -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Agency OS — AI Systems &amp; Automation">
  <meta name="twitter:description" content="We build AI-powered automation, custom software, and business workflows that reduce repetitive manual work.">
  <meta name="twitter:image" content="https://automatedagencyos.tech/assets/logo.webp">

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/static/assets/favicon.png">

  <!-- Geist & Inter Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Geist', 'Inter', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brandDark: '#070707',
            surfaceDark: '#0d0d0f',
          }
        }
      }
    }
  </script>

  <style>
    html {
      scroll-behavior: smooth;
    }
    html, body {
      min-height: 100%;
      margin: 0;
      padding: 0;
      background-color: #070707;
      color: #ffffff;
      font-family: 'Geist', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
      overflow-y: auto;
    }

    .section-border {
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .cta-dark-gradient {
      background: linear-gradient(to bottom, #2B2B2B, #101010);
      border: 1px solid rgba(255, 255, 255, 0.18);
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.45);
      transition: all 0.2s ease-in-out;
    }
    .cta-dark-gradient:hover {
      opacity: 0.92;
      border-color: rgba(255, 255, 255, 0.32);
      transform: translateY(-1px);
    }
    .cta-dark-gradient:active {
      transform: translateY(0);
    }

    .glass-pill {
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      transition: all 0.2s ease;
    }
    .glass-pill:hover {
      background: rgba(255, 255, 255, 0.14);
      border-color: rgba(255, 255, 255, 0.22);
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.04);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .glass-card:hover {
      background: rgba(255, 255, 255, 0.07);
      border-color: rgba(255, 255, 255, 0.18);
      transform: translateY(-2px);
    }

    /* Hero Stagger Entrance Animations */
    @keyframes heroFadeUp {
      from {
        opacity: 0;
        transform: translateY(24px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .hero-anim-eyebrow {
      animation: heroFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
    }
    .hero-anim-headline {
      animation: heroFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
    }
    .hero-anim-subhead {
      animation: heroFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
    }
    .hero-anim-cta {
      animation: heroFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.55s both;
    }

    /* Editorial Scroll Reveal Animations */
    .scroll-reveal {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }
    .scroll-reveal.in-view {
      opacity: 1;
      transform: translateY(0);
    }

    /* Staggered Children inside scroll-reveal */
    .scroll-reveal.in-view .stagger-1 { transition-delay: 0.1s; }
    .scroll-reveal.in-view .stagger-2 { transition-delay: 0.2s; }
    .scroll-reveal.in-view .stagger-3 { transition-delay: 0.3s; }
    .scroll-reveal.in-view .stagger-4 { transition-delay: 0.4s; }

    /* Modal Styling */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 100;
      background: rgba(0, 0, 0, 0.78);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }
    .modal-backdrop.open {
      opacity: 1;
      pointer-events: auto;
    }
    .modal-box {
      background: #0f0f11;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 1.25rem;
      max-width: 34rem;
      width: 100%;
      padding: 2rem;
      position: relative;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.75);
      transform: scale(0.96);
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .modal-backdrop.open .modal-box {
      transform: scale(1);
    }

    /* Marquee animation */
    @keyframes marqueeScroll {
      0% { transform: translateX(0%); }
      100% { transform: translateX(-50%); }
    }
    .marquee-track {
      display: flex;
      width: max-content;
      animation: marqueeScroll 25s linear infinite;
    }
    .marquee-track:hover {
      animation-play-state: paused;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
      .scroll-reveal {
        opacity: 1 !important;
        transform: none !important;
      }
      .marquee-track {
        animation: none !important;
      }
      .hero-anim-eyebrow,
      .hero-anim-headline,
      .hero-anim-subhead,
      .hero-anim-cta {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
    }
  </style>
</head>
<body>

  <!-- ====================================================================
       PERSISTENT TOP NAVIGATION HEADER
       ==================================================================== -->
  <header class="sticky top-0 z-50 w-full px-5 py-4 sm:px-8 lg:px-12 flex items-center justify-between bg-[#070707]/80 backdrop-blur-lg border-b border-white/10 transition-all">
    <!-- Left: Logo & Brand -->
    <a href="#home" class="flex items-center gap-3 text-white no-underline group" aria-label="Agency OS Home">
      <div class="w-9 h-9 rounded-full bg-white/10 border border-white/20 backdrop-blur-md flex items-center justify-center shadow-md group-hover:scale-105 transition">
        <span class="text-white font-bold text-sm tracking-wider">A</span>
      </div>
      <div class="flex flex-col">
        <span class="text-lg font-semibold tracking-tight leading-none text-white">AGENCY OS</span>
        <span class="text-[11px] text-white/60 tracking-normal mt-0.5">AI Systems &amp; Automation</span>
      </div>
    </a>

    <!-- Center: Desktop Glass Nav Cluster -->
    <nav class="hidden md:flex items-center rounded-full bg-white/10 px-2 py-1.5 backdrop-blur-lg border border-white/10 shadow-lg gap-1" aria-label="Main Navigation">
      <a href="#solutions" class="rounded-full px-4 py-1.5 text-sm font-medium text-white/80 hover:bg-white/10 hover:text-white transition">Solutions</a>
      <a href="#problems" class="rounded-full px-4 py-1.5 text-sm font-medium text-white/80 hover:bg-white/10 hover:text-white transition">Problems Solved</a>
      <a href="#how-it-works" class="rounded-full px-4 py-1.5 text-sm font-medium text-white/80 hover:bg-white/10 hover:text-white transition">How It Works</a>
      <a href="#demos" class="rounded-full px-4 py-1.5 text-sm font-medium text-white/80 hover:bg-white/10 hover:text-white transition">Demos</a>
      <a href="#automation" class="rounded-full px-4 py-1.5 text-sm font-medium text-white/80 hover:bg-white/10 hover:text-white transition">Automation</a>
      <a href="#contact" class="rounded-full px-4 py-1.5 text-sm font-medium text-white/80 hover:bg-white/10 hover:text-white transition">Contact</a>
    </nav>

    <!-- Right: Desktop CTA Pill -->
    <div class="hidden md:flex items-center gap-3">
      <a href="/login" class="text-xs font-medium text-white/60 hover:text-white transition px-2 py-1">Operator Sign In</a>
      <button
        type="button"
        class="cta-dark-gradient rounded-full px-5 py-2 text-sm font-medium text-white self-stretch flex items-center shadow-lg"
        data-action="open-consultation-modal"
      >
        Get Your Automation Built
      </button>
    </div>

    <!-- Mobile Hamburger Button (md:hidden) -->
    <button
      type="button"
      id="burgerBtn"
      class="md:hidden relative w-10 h-10 rounded-full bg-white/10 backdrop-blur-lg border border-white/15 flex items-center justify-center text-white z-50 transition"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="mobileDrawer"
    >
      <!-- Menu Icon -->
      <svg id="burgerMenuIcon" class="w-5 h-5 transition-all duration-300 transform scale-100 rotate-0 opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <!-- X Icon -->
      <svg id="burgerCloseIcon" class="w-5 h-5 absolute transition-all duration-300 transform scale-0 -rotate-90 opacity-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </header>

  <!-- Mobile Backdrop -->
  <div id="mobileBackdrop" class="fixed inset-0 z-40 bg-black/80 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300" aria-hidden="true"></div>

  <!-- Mobile Drawer -->
  <div
    id="mobileDrawer"
    class="fixed right-0 top-0 z-40 h-full w-72 bg-black/95 backdrop-blur-xl border-l border-white/10 shadow-2xl flex flex-col justify-between px-6 pt-24 pb-8 transform translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
    aria-hidden="true"
  >
    <div class="flex flex-col gap-2">
      <a href="#home" class="mobile-link rounded-xl px-4 py-3 text-base font-medium text-white/80 hover:bg-white/10 hover:text-white transition">Home</a>
      <a href="#solutions" class="mobile-link rounded-xl px-4 py-3 text-base font-medium text-white/80 hover:bg-white/10 hover:text-white transition">Solutions</a>
      <a href="#problems" class="mobile-link rounded-xl px-4 py-3 text-base font-medium text-white/80 hover:bg-white/10 hover:text-white transition">Problems Solved</a>
      <a href="#how-it-works" class="mobile-link rounded-xl px-4 py-3 text-base font-medium text-white/80 hover:bg-white/10 hover:text-white transition">How It Works</a>
      <a href="#demos" class="mobile-link rounded-xl px-4 py-3 text-base font-medium text-white/80 hover:bg-white/10 hover:text-white transition">Demos</a>
      <a href="#automation" class="mobile-link rounded-xl px-4 py-3 text-base font-medium text-white/80 hover:bg-white/10 hover:text-white transition">Automation</a>
      <a href="#contact" class="mobile-link rounded-xl px-4 py-3 text-base font-medium text-white/80 hover:bg-white/10 hover:text-white transition">Contact</a>
      <a href="/login" class="mobile-link rounded-xl px-4 py-3 text-base font-medium text-blue-400 hover:bg-white/10 hover:text-blue-300 transition">Operator Sign In &rarr;</a>
    </div>

    <button
      type="button"
      class="cta-dark-gradient w-full rounded-full py-3 text-center text-sm font-medium text-white shadow-xl"
      data-action="open-consultation-modal"
    >
      Get Your Automation Built
    </button>
  </div>

  <!-- ====================================================================
       01 HERO SECTION (CINEMATIC VIDEO CLIPPED STRICTLY INSIDE)
       ==================================================================== -->
  <section id="home" class="relative min-h-[calc(100vh-73px)] w-full overflow-hidden flex flex-col justify-between">

    <!-- Full-Bleed Background Video strictly constrained inside hero -->
    <video
      class="absolute inset-0 h-full w-full object-cover pointer-events-none"
      autoplay
      loop
      muted
      playsinline
      aria-hidden="true"
    >
      <source
        src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260809_012548_ef22562c-c0ae-4816-ad9d-f8922af4e6a7.mp4"
        type="video/mp4"
      />
    </video>

    <!-- Subtle Cinematic Scrim to Guarantee Text Readability -->
    <div class="absolute inset-0 bg-black/60 pointer-events-none" aria-hidden="true"></div>

    <!-- UI Layer -->
    <div class="relative z-10 flex-1 flex flex-col justify-end">

      <!-- MAIN (BOTTOM-ANCHORED HERO) -->
      <main class="mt-auto w-full px-5 sm:px-8 lg:px-12 pb-6 sm:pb-10 lg:pb-12">
        <div class="w-full flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 sm:gap-8 lg:gap-14">

          <!-- Left: Value Proposition & CTAs -->
          <div class="max-w-2xl">
            <!-- Eyebrow -->
            <div class="hero-anim-eyebrow inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/15 backdrop-blur-md text-[11px] font-semibold uppercase tracking-wider text-white/90 mb-4 sm:mb-6">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" aria-hidden="true"></span>
              <span>AGENCY OS &bull; AI SYSTEMS &amp; AUTOMATION</span>
            </div>

            <!-- Headline -->
            <h1 class="hero-anim-headline text-3xl sm:text-5xl lg:text-[3.75rem] font-semibold text-white leading-[1.08] tracking-tight max-w-xl">
              AI systems that automate your business.
            </h1>

            <!-- Supporting Copy -->
            <p class="hero-anim-subhead mt-3 sm:mt-5 text-sm sm:text-lg text-white/80 max-w-lg leading-relaxed">
              We build AI-powered automation, custom software, and business workflows that reduce repetitive manual work.
            </p>

            <!-- CTA Row -->
            <div class="hero-anim-cta mt-5 sm:mt-8 flex flex-row items-center gap-3 sm:gap-4">
              <button
                type="button"
                class="cta-dark-gradient rounded-full px-5 py-3 sm:px-7 sm:py-3.5 text-xs sm:text-base font-medium text-white shadow-xl flex items-center justify-center gap-2 text-center flex-1 sm:flex-initial"
                data-action="open-consultation-modal"
              >
                <span>Get Your Automation Built</span>
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>

              <a
                href="#demos"
                class="glass-pill rounded-full px-4 py-3 sm:px-6 sm:py-3.5 text-xs sm:text-base font-medium text-white/85 hover:text-white flex items-center justify-center gap-2 text-center flex-1 sm:flex-initial"
              >
                <span>See a Working Demo</span>
                <svg class="w-4 h-4 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polygon points="10 8 16 12 10 16 10 8"></polygon>
                </svg>
              </a>
            </div>
          </div>

          <!-- Right: Two Customer-Facing Glass Capability Cards -->
          <div class="flex flex-row overflow-x-auto no-scrollbar gap-3 snap-x lg:flex-col lg:overflow-visible max-w-full lg:max-w-md w-full shrink-0">

            <!-- Card 1: AI Automation -->
            <div class="glass-card rounded-2xl p-5 sm:p-6 text-left min-w-[270px] sm:min-w-[320px] lg:min-w-0 snap-start flex-1 shrink-0 lg:shrink">
              <div class="text-[10px] font-bold tracking-wider text-white/60 uppercase mb-1">
                AI AUTOMATION
              </div>
              <h2 class="text-sm sm:text-lg font-semibold text-white leading-snug mb-1.5">
                Automate the work that keeps repeating.
              </h2>
              <p class="text-xs sm:text-sm text-white/80 leading-relaxed line-clamp-3 sm:line-clamp-none">
                Lead capture, qualification, follow-ups, CRM workflows, appointments, customer support, onboarding, and reporting.
              </p>
              <div class="mt-2.5 pt-2 sm:mt-3 sm:pt-3 border-t border-white/10 text-[10px] sm:text-[11px] text-white/60 font-medium">
                Built around your actual business process.
              </div>
            </div>

            <!-- Card 2: Custom Software -->
            <div class="glass-card rounded-2xl p-5 sm:p-6 text-left min-w-[270px] sm:min-w-[320px] lg:min-w-0 snap-start flex-1 shrink-0 lg:shrink">
              <div class="text-[10px] font-bold tracking-wider text-white/60 uppercase mb-1">
                CUSTOM SOFTWARE
              </div>
              <h2 class="text-sm sm:text-lg font-semibold text-white leading-snug mb-1.5">
                Software built around your business.
              </h2>
              <p class="text-xs sm:text-sm text-white/80 leading-relaxed line-clamp-3 sm:line-clamp-none">
                Websites, AI assistants, booking systems, quote flows, customer portals, internal dashboards, and custom applications.
              </p>
              <div class="mt-2.5 pt-2 sm:mt-3 sm:pt-3 border-t border-white/10 text-[10px] sm:text-[11px] text-white/60 font-medium">
                Designed, built, deployed, and maintained.
              </div>
            </div>

          </div>

        </div>
      </main>

    </div>
  </section>

  <!-- ====================================================================
       02 VISUAL SHOWCASE / MARQUEE (EDITORIAL FULL-WIDTH TRANSITION)
       ==================================================================== -->
  <section class="border-y border-white/10 bg-[#0a0a0c] py-10 sm:py-14 overflow-hidden" aria-label="Capabilities Marquee">
    <div class="marquee-track flex items-center gap-10 sm:gap-16 font-extrabold tracking-tighter uppercase whitespace-nowrap text-3xl sm:text-5xl lg:text-6xl text-white/30 hover:text-white/60 transition-colors">
      <span class="hover:text-white transition">AI AUTOMATION</span>
      <span class="text-emerald-400/40 text-xl sm:text-2xl">&bull;</span>
      <span class="hover:text-white transition">CUSTOM SOFTWARE</span>
      <span class="text-emerald-400/40 text-xl sm:text-2xl">&bull;</span>
      <span class="hover:text-white transition">AI AGENTS</span>
      <span class="text-emerald-400/40 text-xl sm:text-2xl">&bull;</span>
      <span class="hover:text-white transition">WORKFLOW AUTOMATION</span>
      <span class="text-emerald-400/40 text-xl sm:text-2xl">&bull;</span>
      <span class="hover:text-white transition">BUSINESS PROCESS AUTOMATION</span>
      <span class="text-emerald-400/40 text-xl sm:text-2xl">&bull;</span>
      <span class="hover:text-white transition">ONGOING MANAGEMENT</span>
      <span class="text-emerald-400/40 text-xl sm:text-2xl">&bull;</span>
      <!-- Duplicate for seamless infinite loop with test compatibility -->
      <span class="hover:text-white transition">AI AUTOMATION</span>
      <span class="text-emerald-400/40 text-xl sm:text-2xl">&bull;</span>
      <span class="hover:text-white transition">CUSTOM SOFTWARE</span>
      <span class="text-emerald-400/40 text-xl sm:text-2xl">&bull;</span>
      <span class="hover:text-white transition">AI AGENTS</span>
      <span class="text-emerald-400/40 text-xl sm:text-2xl">&bull;</span>
      <span class="hover:text-white transition">WORKFLOW AUTOMATION</span>
      <span class="text-emerald-400/40 text-xl sm:text-2xl">&bull;</span>
      <span class="hover:text-white transition">BUSINESS PROCESS AUTOMATION</span>
      <span class="text-emerald-400/40 text-xl sm:text-2xl">&bull;</span>
      <span class="hover:text-white transition">ONGOING MANAGEMENT</span>
      <span class="text-emerald-400/40 text-xl sm:text-2xl">&bull;</span>
    </div>
    <!-- Editorial Sub-Ticker Tagline -->
    <div class="mt-4 flex items-center justify-center gap-6 text-[11px] font-mono tracking-widest text-white/40 uppercase text-center px-4 overflow-hidden">
      <span>AI Automation</span>
      <span>&bull;</span>
      <span>Custom Software</span>
      <span>&bull;</span>
      <span>AI Agents</span>
      <span>&bull;</span>
      <span>Workflow Automation</span>
      <span>&bull;</span>
      <span>Business Dashboards</span>
      <span>&bull;</span>
      <span>Customer Systems</span>
      <span>&bull;</span>
      <span>Ongoing Management</span>
    </div>
  </section>

  <!-- ====================================================================
       03 WHAT WE BUILD (#solutions) — EDITORIAL ARCHITECTURAL BENTO GRID
       ==================================================================== -->
  <section id="solutions" class="section-border py-28 sm:py-36 px-5 sm:px-8 lg:px-12 max-w-7xl mx-auto w-full scroll-reveal">
    
    <!-- Section Header -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-16 sm:mb-20">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-mono font-medium text-emerald-400 uppercase tracking-widest mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
