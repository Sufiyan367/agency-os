  <!-- Interactive Logic: Scroll Reveal, Mobile Drawer, and Lead Capture Modal -->
  <script>
    (function () {
      'use strict';

      // Elements
      const burgerBtn = document.getElementById('burgerBtn');
      const burgerMenuIcon = document.getElementById('burgerMenuIcon');
      const burgerCloseIcon = document.getElementById('burgerCloseIcon');
      const mobileBackdrop = document.getElementById('mobileBackdrop');
      const mobileDrawer = document.getElementById('mobileDrawer');
      const consultationModal = document.getElementById('consultationModal');
      const closeConsultationModal = document.getElementById('closeConsultationModal');
      const consultationForm = document.getElementById('consultationForm');
      const consultationAlert = document.getElementById('consultationAlert');
      const consultationSubmitBtn = document.getElementById('consultationSubmitBtn');

      let isDrawerOpen = false;

      // Reusable Scroll-Triggered Reveal via IntersectionObserver (useInViewAnimation pattern)
      function initScrollAnimations() {
        if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                obs.unobserve(entry.target);
              }
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -30px 0px' });

          document.querySelectorAll('.scroll-reveal').forEach(el => {
            observer.observe(el);
          });
        } else {
          document.querySelectorAll('.scroll-reveal').forEach(el => {
            el.classList.add('in-view');
          });
        }
      }
      initScrollAnimations();

      // Toggle Mobile Drawer
      function openDrawer() {
        isDrawerOpen = true;
        burgerBtn.setAttribute('aria-expanded', 'true');
        burgerMenuIcon.classList.replace('scale-100', 'scale-0');
        burgerMenuIcon.classList.replace('opacity-100', 'opacity-0');
        burgerMenuIcon.classList.replace('rotate-0', 'rotate-90');
        burgerCloseIcon.classList.replace('scale-0', 'scale-100');
        burgerCloseIcon.classList.replace('opacity-0', 'opacity-100');
        burgerCloseIcon.classList.replace('-rotate-90', 'rotate-0');

        mobileBackdrop.classList.remove('opacity-0', 'pointer-events-none');
        mobileBackdrop.classList.add('opacity-100', 'pointer-events-auto');
        mobileDrawer.classList.remove('translate-x-full');
        mobileDrawer.classList.add('translate-x-0');
        mobileDrawer.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function closeDrawer() {
        isDrawerOpen = false;
        burgerBtn.setAttribute('aria-expanded', 'false');
        burgerMenuIcon.classList.replace('scale-0', 'scale-100');
        burgerMenuIcon.classList.replace('opacity-0', 'opacity-100');
        burgerMenuIcon.classList.replace('rotate-90', 'rotate-0');
        burgerCloseIcon.classList.replace('scale-100', 'scale-0');
        burgerCloseIcon.classList.replace('opacity-100', 'opacity-0');
        burgerCloseIcon.classList.replace('rotate-0', '-rotate-90');

        mobileBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
        mobileBackdrop.classList.add('opacity-0', 'pointer-events-none');
        mobileDrawer.classList.remove('translate-x-0');
        mobileDrawer.classList.add('translate-x-full');
        mobileDrawer.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      burgerBtn.addEventListener('click', function () {
        if (isDrawerOpen) closeDrawer();
        else openDrawer();
      });

      mobileBackdrop.addEventListener('click', closeDrawer);

      document.querySelectorAll('.mobile-link').forEach(link => {
        link.addEventListener('click', closeDrawer);
      });

      window.addEventListener('resize', function () {
        if (window.innerWidth >= 768 && isDrawerOpen) {
          closeDrawer();
        }
      });

      // Modal Handling
      function openModal() {
        closeDrawer();
        consultationModal.classList.add('open');
        consultationModal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        consultationModal.classList.remove('open');
        consultationModal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      document.querySelectorAll('[data-action="open-consultation-modal"]').forEach(btn => {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          openModal();
        });
      });

      closeConsultationModal.addEventListener('click', closeModal);

      consultationModal.addEventListener('click', function (e) {
        if (e.target === consultationModal) {
          closeModal();
        }
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          if (isDrawerOpen) closeDrawer();
          if (consultationModal.classList.contains('open')) closeModal();
        }
      });

      // Lead Submission via Existing Backend Pipeline
      consultationForm.addEventListener('submit', async function (e) {
        e.preventDefault();

        consultationAlert.className = 'hidden mb-4 p-3 rounded-lg text-xs font-medium';
        consultationAlert.textContent = '';
        consultationSubmitBtn.disabled = true;
        const origText = consultationSubmitBtn.textContent;
        consultationSubmitBtn.textContent = 'Submitting Request...';

        const payload = {
          name: document.getElementById('consultationName').value.trim(),
          company: document.getElementById('consultationCompany').value.trim(),
          email: document.getElementById('consultationEmail').value.trim(),
          website: document.getElementById('consultationWebsite').value.trim(),
          service_interest: 'AI Automation & Custom Software',
          problem: document.getElementById('consultationProblem').value.trim(),
          what_they_want_automated: document.getElementById('consultationAutomated').value.trim(),
          message: `Automate: ${document.getElementById('consultationAutomated').value.trim()} | Bottleneck: ${document.getElementById('consultationProblem').value.trim()}`
        };

        try {
          let res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          if (res.status === 404) {
            res = await fetch('/api/v1/onboarding/consultation', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                name: payload.name,
                email: payload.email,
                company: payload.company,
                service_interest: payload.service_interest,
                notes: payload.message,
                current_process: payload.message
              })
            });
          }

          if (res.ok) {
            consultationAlert.className = 'mb-4 p-3 rounded-lg text-xs font-medium bg-emerald-950/80 border border-emerald-600 text-emerald-300';
            consultationAlert.textContent = 'Thank you — your assessment request has been received. Our engineering team will review your business process and respond within 24 business hours.';
            consultationForm.reset();
            setTimeout(() => {
              closeModal();
            }, 3500);
          } else {
            let errorMsg = 'Unable to process request. Please verify all fields and retry.';
            try {
              const data = await res.json();
              if (data && data.detail) errorMsg = typeof data.detail === 'string' ? data.detail : JSON.stringify(data.detail);
            } catch (_) {}
            consultationAlert.className = 'mb-4 p-3 rounded-lg text-xs font-medium bg-red-950/80 border border-red-600 text-red-300';
            consultationAlert.textContent = errorMsg;
          }
        } catch (err) {
          consultationAlert.className = 'mb-4 p-3 rounded-lg text-xs font-medium bg-red-950/80 border border-red-600 text-red-300';
          consultationAlert.textContent = 'Network error connecting to server. Please try again.';
        } finally {
          consultationSubmitBtn.disabled = false;
          consultationSubmitBtn.textContent = origText;
        }
      });

      // Inline Contact Form Submission
      const inlineForm = document.getElementById('inlineContactForm');
      const inlineAlert = document.getElementById('inlineContactAlert');
      const inlineSubmitBtn = document.getElementById('inlineSubmitBtn');

      if (inlineForm) {
        inlineForm.addEventListener('submit', async function (e) {
          e.preventDefault();

          inlineAlert.className = 'hidden mb-4 p-3 rounded-lg text-xs font-medium';
          inlineAlert.textContent = '';
          inlineSubmitBtn.disabled = true;
          const origText = inlineSubmitBtn.textContent;
          inlineSubmitBtn.textContent = 'Submitting Request...';

          const payload = {
            name: document.getElementById('inlineName').value.trim(),
            company: document.getElementById('inlineCompany').value.trim(),
            email: document.getElementById('inlineEmail').value.trim(),
            website: document.getElementById('inlineWebsite').value.trim(),
            service_interest: 'AI Automation & Custom Software',
            problem: document.getElementById('inlineProblem').value.trim(),
            what_they_want_automated: document.getElementById('inlineAutomated').value.trim(),
            message: `Automate: ${document.getElementById('inlineAutomated').value.trim()} | Bottleneck: ${document.getElementById('inlineProblem').value.trim()}`
          };

          try {
            let res = await fetch('/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            if (res.status === 404) {
              res = await fetch('/api/v1/onboarding/consultation', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  name: payload.name,
                  email: payload.email,
                  company: payload.company,
                  service_interest: payload.service_interest,
                  notes: payload.message,
                  current_process: payload.message
                })
              });
            }

            if (res.ok) {
              inlineAlert.className = 'mb-4 p-3 rounded-lg text-xs font-medium bg-emerald-950/80 border border-emerald-600 text-emerald-300';
              inlineAlert.textContent = 'Thank you — your assessment request has been received. Our engineering team will review your business process and respond within 24 business hours.';
              inlineForm.reset();
            } else {
              let errorMsg = 'Unable to process request. Please verify all fields and retry.';
              try {
                const data = await res.json();
                if (data && data.detail) errorMsg = typeof data.detail === 'string' ? data.detail : JSON.stringify(data.detail);
              } catch (_) {}
              inlineAlert.className = 'mb-4 p-3 rounded-lg text-xs font-medium bg-red-950/80 border border-red-600 text-red-300';
              inlineAlert.textContent = errorMsg;
            }
          } catch (err) {
            inlineAlert.className = 'mb-4 p-3 rounded-lg text-xs font-medium bg-red-950/80 border border-red-600 text-red-300';
            inlineAlert.textContent = 'Network error connecting to server. Please try again.';
          } finally {
            inlineSubmitBtn.disabled = false;
            inlineSubmitBtn.textContent = origText;
          }
        });
      }

    })();
  </script>
</body>
</html>
